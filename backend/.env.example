# Copie este arquivo para .env e ajuste os valores.

PORT=3000

# Segredo usado para assinar os tokens de login. Use um texto longo e aleatório.
# Para gerar um: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-longo

# Backup automático diário (opcional)
BACKUP_AUTO_HOUR=7
BACKUP_AUTO_MINUTE=30
# Pasta onde os backups são salvos. Apontar para uma pasta do Google Drive
# Desktop faz o backup ir para a nuvem automaticamente.
# BACKUP_DIRECTORY=C:\caminho\para\pasta\de\backups
